    {
      "field": "text_48",
      "shape_id": 48,
      "shape_name": "object 48",
      "type": "text",
      "group_path": [],
      "source_text": "使用Trello、Jira等工具，清晰跟踪任务进度。这些工具可以帮助团队更好地分配任务、设置截止日期，并实时监控项目进展。\n项目管理工具和文档协作工具的结合，可以让团队工作更加透明化",
      "source_sample_chars": 91,
      "max_chars": 136,
      "typography_role": "chinese_body",
      "semantic_role": "provisional",
      "bounds_emu_local": [
