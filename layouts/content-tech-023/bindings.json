    },
    {
      "field": "text_49",
      "shape_id": 49,
      "shape_name": "object 48",
      "type": "text",
      "group_path": [],
      "source_text": "通过Notion、飞书等工具，实现团队高效协作。多人同时编辑、评论和分享文档，减少沟通成本，提升工作效率。\n选择适合的工具，能够帮助员工更好地管理任务、沟通协作。",
      "source_sample_chars": 81,
