    {
      "field": "text_193",
      "shape_id": 193,
      "shape_name": "TextBox 350",
      "type": "text",
      "group_path": [
        202
      ],
      "source_text": "设备绑定与激活：记录每颗芯片的出厂ID、部署位置（如服务器、汽车ECU），防止窜货与伪造。\n\n远程监控：通过OTA（空中升级）收集芯片运行状态（温度、功耗、错误日志），实现预测性维护。",
      "source_sample_chars": 92,
      "max_chars": 138,
      "typography_role": "chinese_body",
      "semantic_role": "provisional",
      "bounds_emu_local": [
        5255670,
