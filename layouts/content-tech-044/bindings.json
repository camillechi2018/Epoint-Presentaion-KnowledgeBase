    {
      "field": "text_58",
      "shape_id": 58,
      "shape_name": "TextBox 350",
      "type": "text",
      "group_path": [
        201
      ],
      "source_text": "EDA工具链集成：支持主流EDA工具（如Cadence、Synopsys、Mentor）的数据交互，实现RTL设计、仿真验证和物理设计的协同管理。\n\nIP核管理：提供第三方IP库的版本控制、授权跟踪和合规性检查，避免供应链风险。",
      "source_sample_chars": 114,
      "max_chars": 171,
      "typography_role": "chinese_body",
      "semantic_role": "provisional",
      "bounds_emu_local": [
        1372402,
        1993285,
        1680661,
        1680973
      ]
    },
    {
