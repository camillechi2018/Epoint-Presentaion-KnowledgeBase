      "group_path": [
        202
      ],
      "source_text": "芯片部署与运维",
      "source_sample_chars": 7,
      "max_chars": 24,
      "typography_role": "chinese_heading",
      "semantic_role": "provisional",
      "bounds_emu_local": [
