    {
      "field": "text_62",
      "shape_id": 62,
      "shape_name": "TextBox 350",
      "type": "text",
      "group_path": [
        198
      ],
      "source_text": "晶圆追踪（Wafer Tracking）：通过RFID或二维码记录每片晶圆的制造数据（如工艺参数、良率），支持缺陷定位与根因分析。\n\n测试自动化：对接ATE（自动测试设备），管理测试向量、Bin分类及失效分析（FA）数据。",
      "source_sample_chars": 111,
      "max_chars": 166,
      "typography_role": "chinese_body",
      "semantic_role": "provisional",
      "bounds_emu_local": [
        2719525,
