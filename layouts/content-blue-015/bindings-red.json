      "shape_id": 60,
      "shape_name": "文本框 59",
      "type": "text",
      "max_chars": 140,
      "source_sample_chars": 70,
      "source_text": "项目概述：启动并实施了企业数字化转型项目，包括引入新技术、改进业务流程和加强数字化培训。\n主要成果：业务流程数字化提升了整体运营效率30%。",
      "bounds_pt": [
        234.8,
        332.9,
