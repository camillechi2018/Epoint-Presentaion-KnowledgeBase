    {
      "field": "text_25",
      "shape_id": 25,
      "shape_name": "文本框 24",
      "type": "text",
      "max_chars": 170,
      "source_sample_chars": 85,
      "source_text": "流程改进实施：对关键业务流程进行了优化，减少了冗余步骤，使操作时间缩短了20%。\n工具赋能增效：引入RPA和智能化工具，自动化处理重复性工作内容，有效释放30%人力资源。",
      "bounds_pt": [
        70.2,
        416.0,
        375.5,
        83.3
      ],
      "semantic_role": "provisional"
    },
    {
