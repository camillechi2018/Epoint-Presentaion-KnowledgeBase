    {
      "field": "text_23",
      "shape_id": 23,
      "shape_name": "文本框 22",
      "type": "text",
      "max_chars": 134,
      "source_sample_chars": 67,
      "source_text": "人才结构优化：成功引进10名高校人才，人才保留率达到95%，团队能力显著增强。\n服务创新奖励：设立了服务创新奖，激励团队提升服务水平。",
      "bounds_pt": [
        644.7,
        202.9,
        260.8,
        88.4
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_24",
      "shape_id": 24,
      "shape_name": "文本框 23",
      "type": "text",
      "max_chars": 24,
      "source_sample_chars": 9,
      "source_text": "04.优化业务流程",
      "bounds_pt": [
        70.2,
        378.7,
        375.6,
        36.9
      ],
      "semantic_role": "provisional"
