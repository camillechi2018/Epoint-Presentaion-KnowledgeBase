      "semantic_role": "provisional"
    },
    {
      "field": "text_32",
      "shape_id": 32,
      "shape_name": "文本框 31",
      "type": "text",
      "max_chars": 84,
      "source_sample_chars": 42,
      "source_text": "目标：通过加深与现有客户的合作关系，提升客户的忠诚度和满意度，增强公司的市场竞争力。",
      "bounds_pt": [
        741.9,
        179.5,
