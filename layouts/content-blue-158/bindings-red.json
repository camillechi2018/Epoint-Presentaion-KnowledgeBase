    },
    {
      "field": "text_29",
      "shape_id": 29,
      "shape_name": "文本框 28",
      "type": "text",
      "max_chars": 90,
      "source_sample_chars": 45,
      "source_text": "目标：强化团队成员之间的沟通与协作，确保信息及时、准确传递，提升团队的整体执行力和灵活性。",
      "bounds_pt": [
        218.1,
        265.1,
