        60.1
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_30",
      "shape_id": 30,
      "shape_name": "文本框 29",
      "type": "text",
      "max_chars": 76,
      "source_sample_chars": 38,
      "source_text": "目标：提升团队成员的专业技能和软技能，同时培养团队的协作交流和问题解决能力。",
      "bounds_pt": [
        392.6,
        236.6,
        174.6,
        60.1
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_31",
      "shape_id": 31,
      "shape_name": "文本框 30",
      "type": "text",
      "max_chars": 82,
      "source_sample_chars": 41,
      "source_text": "目标：确保团队和个人的工作目标与公司的整体战略目标对接，推动持续改进和目标的达成。",
      "bounds_pt": [
        567.3,
        208.0,
