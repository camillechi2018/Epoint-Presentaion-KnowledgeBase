        60.1
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_34",
      "shape_id": 34,
      "shape_name": "文本框 33",
      "type": "text",
      "max_chars": 58,
      "source_sample_chars": 29,
      "source_text": "通过使用自动化系统、或者流程简化来减少冗余，提升团队效率。",
      "bounds_pt": [
        48.9,
        444.9,
        163.8,
