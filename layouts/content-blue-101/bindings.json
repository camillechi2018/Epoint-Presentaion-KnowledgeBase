    },
    {
      "field": "text_45",
      "shape_id": 45,
      "shape_name": "文本框 44",
      "type": "text",
      "max_chars": 102,
      "source_sample_chars": 51,
      "source_text": "严格检查每项任务的执行质量，确保交付成果符合预定标准。目标是通过质量检查，以确保合格率达到95%以上。",
      "bounds_pt": [
        603.5,
