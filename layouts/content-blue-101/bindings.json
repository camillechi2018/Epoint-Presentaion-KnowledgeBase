      "shape_id": 44,
      "shape_name": "文本框 43",
      "type": "text",
      "max_chars": 112,
      "source_sample_chars": 56,
      "source_text": "确保项目按计划进展，按时完成每个阶段的任务，并通过定期汇报更新项目进度。目标是保持任务按时完成率达到90%以上。",
      "bounds_pt": [
