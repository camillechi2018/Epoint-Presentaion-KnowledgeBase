        60.1
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_46",
      "shape_id": 46,
      "shape_name": "文本框 45",
      "type": "text",
      "max_chars": 90,
      "source_sample_chars": 45,
      "source_text": "高效调配资源，包括人力、物力和财力，确保资源分配任务在预算内完成，资源浪费控制在5%以内。",
      "bounds_pt": [
        114.4,
        210.1,
        220.4,
        60.1
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_47",
      "shape_id": 47,
      "shape_name": "文本框 46",
      "type": "text",
      "max_chars": 116,
      "source_sample_chars": 58,
      "source_text": "加强团队沟通与协作，确保信息流通畅，问题及时解决。目标是提升团队成员的满意度和协作效率，达到80%以上的团队满意度。",
      "bounds_pt": [
        621.2,
        210.1,
        220.4,
        60.1
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_48",
      "shape_id": 48,
      "shape_name": "文本框 47",
      "type": "text",
      "max_chars": 96,
      "source_sample_chars": 48,
      "source_text": "定期识别评估任务执行过程中可能出现的风险并制定应对方案。目标是重大风险发生的概率控制在5%以下。",
      "bounds_pt": [
        113.1,
        317.2,
        198.8,
        60.1
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_49",
      "shape_id": 49,
      "shape_name": "文本框 48",
      "type": "text",
      "max_chars": 100,
      "source_sample_chars": 50,
      "source_text": "确保客户对任务成果的满意度，定期进行客户反馈调查，及时调整工作方向。目标是客户满意度达到90%以上。",
      "bounds_pt": [
        651.3,
        317.2,
        198.8,
        60.1
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_50",
