      "shape_id": 48,
      "shape_name": "文本框 47",
      "type": "text",
      "max_chars": 106,
      "source_sample_chars": 53,
      "source_text": "口碑转化：举办2场项目成果展示会，凭借优质交付成果与客户续签3年战略合作协议，新增订单金额达420万元。​",
      "bounds_pt": [
        56.5,
        348.5,
