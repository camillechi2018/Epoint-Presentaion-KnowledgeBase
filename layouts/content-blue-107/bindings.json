        62.7
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_49",
      "shape_id": 49,
      "shape_name": "文本框 48",
      "type": "text",
      "max_chars": 114,
      "source_sample_chars": 57,
      "source_text": "流程再造：联合市场、财务、运营等部门，诊断优化5个冗余环节，合同审批周期从10天缩短至6天，提升了整体工作效率。​",
      "bounds_pt": [
        352.9,
        140.6,
