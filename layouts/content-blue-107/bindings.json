      "shape_name": "文本框 49",
      "type": "text",
      "max_chars": 140,
      "source_sample_chars": 70,
      "source_text": "分层培训：开展8场培训（含3场新员工培训、3场技能提升培训、2场管理培训），邀请5次行业专家授课，员工技能测评优秀率从40%提升至65%。​",
      "bounds_pt": [
        352.9,
        348.5,
