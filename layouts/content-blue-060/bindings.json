    {
      "field": "text_26",
      "shape_id": 26,
      "shape_name": "文本框 25",
      "type": "text",
      "max_chars": 85,
      "source_sample_chars": 95,
      "source_text": "KR1：参与了行业内的交流会，促进了与行业领袖人物的互动与合作。\nKR2：与1行业内的资深专家建立了持续联系，并保持了良好的关系。\nKR3：启动了2个跨行业合作项目为公司带来了新的合作机会。",
      "bounds_pt": [
        280.8,
        300.8,
        175.9,
