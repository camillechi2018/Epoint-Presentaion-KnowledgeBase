      "max_lines": 2
    },
    {
      "field": "text_27",
      "shape_id": 27,
      "shape_name": "文本框 26",
      "type": "text",
      "max_chars": 85,
      "source_sample_chars": 94,
      "source_text": "KR1：优化了沟通流程，确保信息传递高效透明，减少了工作重叠。\nKR2：与团队成员进行了绩效评估与反馈，明确个人职业发展方向。\nKR3：培养了团队成员决策能力，提升了团队的自主性和责任感。",
      "bounds_pt": [
        501.8,
        300.8,
        175.9,
        134.8
      ],
      "semantic_role": "step_body",
      "semantic_path": "steps[2].body",
