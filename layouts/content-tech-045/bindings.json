    {
      "field": "text_76",
      "shape_id": 76,
      "shape_name": "Text 8",
      "type": "text",
      "group_path": [],
      "source_text": "基于10万+用户记忆库，AI构建‘如果那时’剧情：若你选择了另一条路、回应了那个微笑，人生会如何分叉？可定制虚拟短片或互动小说。",
      "source_sample_chars": 64,
      "max_chars": 96,
      "typography_role": "chinese_body",
      "semantic_role": "reviewed_text",
      "bounds_emu_local": [
