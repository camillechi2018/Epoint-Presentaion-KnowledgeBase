        83.3
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_44",
      "shape_id": 44,
      "shape_name": "文本框 43",
      "type": "text",
      "max_chars": 110,
      "source_sample_chars": 55,
      "source_text": "项目收尾：全力推进重点项目收尾工作，确保按期交付验收。\n目标达成：奋力冲刺确保全年指标超额完成，交出优异答卷。",
