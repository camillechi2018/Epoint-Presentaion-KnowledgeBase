      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_43",
      "shape_id": 43,
      "shape_name": "文本框 42",
      "type": "text",
      "max_chars": 110,
      "source_sample_chars": 55,
      "source_text": "测试发布：全面完成重点新品测试验证，正式发布推向市场。\n推广落地：精心制定新品推广方案，确保上市首月目标达成。",
