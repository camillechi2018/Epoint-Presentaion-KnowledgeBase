        83.3
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_45",
      "shape_id": 45,
      "shape_name": "文本框 44",
      "type": "text",
      "max_chars": 114,
      "source_sample_chars": 57,
      "source_text": "预算编制：系统完成年度预算编制和审批流程，确保资金到位。\n团队组建：快速组建跨部门项目团队明确职责分工和汇报关系。",
      "bounds_pt": [
        67.4,
