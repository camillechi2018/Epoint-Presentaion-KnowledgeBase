      "max_chars": 90,
      "source_sample_chars": 45,
      "source_text": "本报告旨在分析公司在2023年和2024年的产品销售情况，并探讨销售趋势和关键因素的变化。",
      "bounds_pt": [
        50.7,
        90.7,
