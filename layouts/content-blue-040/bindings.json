      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_54",
      "shape_id": 54,
      "shape_name": "TextBox 33",
      "type": "text",
      "max_chars": 202,
      "source_sample_chars": 101,
      "source_text": "2026年相比于2024年，公司产品整体销售量显著增长。这主要归因于市场对我们产品的接受度提高，以及销售团队的努力和市场推广策略的有效执行。我们在目标市场中获得了更多的市场份额，这直接推动了销量的增长。",
      "bounds_pt": [
        50.7,
        196.0,
        176.9,
        103.5
      ],
      "semantic_role": "provisional"
    },
    {
