      "semantic_role": "provisional"
    },
    {
      "field": "text_52",
      "shape_id": 52,
      "shape_name": "文本框 51",
      "type": "text",
      "max_chars": 116,
      "source_sample_chars": 58,
      "source_text": "技能培训与知识共享：我们组织了多次技能培训，这些培训有效提升了团队成员的综合能力，同时增强了团队的凝聚力和协作意识。",
