        323.5,
        41.9
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_53",
      "shape_id": 53,
      "shape_name": "文本框 52",
      "type": "text",
      "max_chars": 122,
      "source_sample_chars": 61,
      "source_text": "团队协作工具引入：为进一步增强团队合作，我们引入了协作工具，通过这些工具，提高了信息流通的速度，提升了团队整体的工作效能。",
      "bounds_pt": [
        496.6,
        170.5,
        322.3,
        41.9
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_56",
      "shape_id": 56,
      "shape_name": "文本框 55",
      "type": "text",
      "max_chars": 84,
      "source_sample_chars": 42,
      "source_text": "技术难题与解决方案：我们通过外聘专家等方式解决了部分难题，确保项目进度不受过多影响。",
      "bounds_pt": [
