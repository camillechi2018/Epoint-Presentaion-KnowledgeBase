      "field": "text_84",
      "shape_id": 84,
      "shape_name": "文本框 83",
      "type": "text",
      "max_chars": 130,
      "source_sample_chars": 65,
      "source_text": "任务一：制定公司或团队的年度工作目标与计划。\n任务二：分析去年的业绩，并根据反馈调整策略。\n任务三：开展团建活动，提高整体凝聚力。",
      "bounds_pt": [
        56.6,
