      "type": "text",
      "max_chars": 29,
      "source_sample_chars": 72,
      "source_text": "推进项目实施，确保第一季度的计划落地，优化执行流程。\n加强与客户互动，开展客户需求分析，提升客户满意度。\n促进跨部门合作，提高团队整体工作效率。",
      "bounds_pt": [
        278.4,
        274.8,
