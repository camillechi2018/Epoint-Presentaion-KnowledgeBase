    },
    {
      "field": "text_41",
      "shape_id": 41,
      "shape_name": "文本框 40",
      "type": "text",
      "max_chars": 86,
      "source_sample_chars": 43,
      "source_text": "现有技术架构体系难以支撑业务创新发展需求。\n技术人才储备数量与业务发展速度出现不匹配。",
      "bounds_pt": [
