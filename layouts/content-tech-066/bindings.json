        2030725,
        785087
      ]
    },
    {
      "field": "text_90",
      "shape_id": 90,
      "shape_name": "文本框 89",
      "type": "text",
      "group_path": [],
      "source_text": "2018年业务扩张\n收购小型物流公司\n建立同城配送网络。",
      "source_sample_chars": 28,
      "max_chars": 42,
      "typography_role": "chinese_body",
      "semantic_role": "provisional",
      "bounds_emu_local": [
        4241022,
        2966044,
        2147613,
        785087
      ]
    },
    {
      "field": "text_91",
      "shape_id": 91,
      "shape_name": "文本框 90",
      "type": "text",
      "group_path": [],
      "source_text": "2020年转型零售\n试点社区团购\n开启即时电商新模式。",
      "source_sample_chars": 27,
      "max_chars": 40,
      "typography_role": "chinese_body",
      "semantic_role": "provisional",
      "bounds_emu_local": [
        6096000,
        5557892,
        3775393,
        712118
      ]
    },
    {
      "field": "text_92",
      "shape_id": 92,
      "shape_name": "文本框 91",
      "type": "text",
      "group_path": [],
      "source_text": "2021年进军生鲜\n产地直采模式推动\n年交易额突破十亿。",
      "source_sample_chars": 28,
      "max_chars": 42,
      "typography_role": "chinese_body",
      "semantic_role": "provisional",
      "bounds_emu_local": [
        7010176,
        1551001,
        3746538,
        785087
      ]
    },
    {
      "field": "text_93",
      "shape_id": 93,
      "shape_name": "文本框 92",
      "type": "text",
      "group_path": [],
      "source_text": "2023年技术升级\n自研仓储AI调度系统\n提升履约效率。",
      "source_sample_chars": 28,
      "max_chars": 42,
      "typography_role": "chinese_body",
      "semantic_role": "provisional",
      "bounds_emu_local": [
        8810569,
        4386364,
        3767378,
        785087
      ]
    },
    {
      "field": "text_94",
      "shape_id": 94,
      "shape_name": "文本框 93",
      "type": "text",
      "group_path": [],
      "source_text": "2025年\n全品类拓展\n从生鲜向日用百货延伸，\n用户覆盖全国。",
      "source_sample_chars": 31,
      "max_chars": 46,
      "typography_role": "chinese_body",
