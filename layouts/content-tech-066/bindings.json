      "field": "text_66",
      "shape_id": 66,
      "shape_name": "文本框 65",
      "type": "text",
      "group_path": [],
      "source_text": "2014年创立\n大学生团队在宿舍启动\n校园快递聚合平台项目。",
      "source_sample_chars": 30,
      "max_chars": 45,
