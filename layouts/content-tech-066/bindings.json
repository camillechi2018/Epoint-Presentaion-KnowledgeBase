    },
    {
      "field": "text_67",
      "shape_id": 67,
      "shape_name": "文本框 66",
      "type": "text",
      "group_path": [],
      "source_text": "2016年首轮融资\n覆盖二十城高校\n获千万级天使投资。",
      "source_sample_chars": 27,
      "max_chars": 40,
      "typography_role": "chinese_body",
      "semantic_role": "provisional",
      "bounds_emu_local": [
        2440654,
