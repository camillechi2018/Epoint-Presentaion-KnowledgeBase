    {
      "field": "text_14",
      "shape_id": 14,
      "shape_name": "文本框 13",
      "type": "text",
      "group_path": [],
      "source_text": "化解冲突，促进和谐\n面对团队内部的冲突，采取积极沟通、公正调解的方式，寻求双方都能接受的解决方案。\n培养团队成员的沟通技巧和情绪管理能力，减少冲突的发生。",
      "source_sample_chars": 77,
      "max_chars": 115,
