      "shape_id": 12,
      "shape_name": "文本框 11",
      "type": "text",
      "group_path": [],
      "source_text": "各司其职，协同作战\n根据团队成员的能力和兴趣，合理分配角色和任务，确保团队整体效能最大化。\n建立有效的协同机制，如定期会议、项目进度跟踪等，确保信息流通和资源共享。",
      "source_sample_chars": 82,
      "max_chars": 123,
