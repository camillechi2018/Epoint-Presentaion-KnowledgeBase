      "local_bounds_emu": [
        5263056,
        3212706,
        1666971,
        2101153
      ],
      "text_preview": "化解冲突，促进和谐\n面对团队内部的冲突，采取积极沟通、公正调解的方式，寻求双方都能接受的解决方案。\n培养团队成员的沟通技巧和情绪管理能力，减少冲突的发生。",
      "typography_role": "chinese_body"
    },
    {
