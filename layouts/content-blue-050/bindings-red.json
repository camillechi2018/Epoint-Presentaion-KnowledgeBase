      "shape_name": "文本框 28",
      "type": "text",
      "max_chars": 78,
      "source_sample_chars": 39,
      "source_text": "强化培训与支持：定期为员工提供培训，提升员工专业技能和能力，确保项目顺利推进。",
      "bounds_pt": [
