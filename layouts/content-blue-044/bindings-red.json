      "semantic_role": "provisional"
    },
    {
      "field": "text_37",
      "shape_id": 37,
      "shape_name": "文本框 36",
      "type": "text",
      "max_chars": 86,
      "source_sample_chars": 43,
      "source_text": "建立项目全周期风险评估机制，提升抗风险能力。\n制定项目关键节点风险预警清单和应对预案。",
