      "type": "text",
      "group_path": [],
      "source_text": "信任是团队协作的基础，通过诚实、透明的沟通建立信任 \n信任能够增强团队凝聚力，提高团队效率",
      "source_sample_chars": 45,
      "max_chars": 67,
      "typography_role": "chinese_body",
