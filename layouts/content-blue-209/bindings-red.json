      "shape_id": 37,
      "shape_name": "文本框 36",
      "type": "text",
      "max_chars": 132,
      "source_sample_chars": 66,
      "source_text": "产品开发：开发产品核心功能，进行初步测试。\n内测与反馈：小范围内测，修复问题并优化体验。\n市场预热：启动线上广告推广和社交媒体宣传。",
      "bounds_pt": [
        318.5,
