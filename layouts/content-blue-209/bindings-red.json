      "shape_id": 33,
      "shape_name": "文本框 32",
      "type": "text",
      "max_chars": 134,
      "source_sample_chars": 67,
      "source_text": "市场调研：分析市场需求和竞争对手，收集用户反馈。\n用户访谈：与潜在用户交流了解他们的痛点。\n产品规划：确定产品定位和功能和开发时间表。",
      "bounds_pt": [
        116.7,
        154.5,
        170.6,
        124.7
      ],
      "semantic_role": "provisional"
    },
    {
