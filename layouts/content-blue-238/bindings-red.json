      "shape_name": "文本框 26",
      "type": "text",
      "max_chars": 176,
      "source_sample_chars": 88,
      "source_text": "成果评估：评估项目目标是否达成，检查交付物的质量和效果。\n收尾文档：编写项目总结报告，记录关键经验、问题和解决方案。\n项目评审：进行项目复盘，学习经验教训，为未来项目提供参考。",
      "bounds_pt": [
        732.5,
        178.9,
        184.1,
        124.7
      ],
      "semantic_role": "provisional"
    },
