      "shape_name": "文本框 63",
      "type": "text",
      "max_chars": 80,
      "source_sample_chars": 40,
      "source_text": "缺少完善的质量评估工具和方法，无法及时发现问题并进行调整，影响了最终交付的质量。",
      "bounds_pt": [
