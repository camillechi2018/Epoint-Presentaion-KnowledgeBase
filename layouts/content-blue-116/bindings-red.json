    },
    {
      "field": "text_59",
      "shape_id": 59,
      "shape_name": "文本框 58",
      "type": "text",
      "max_chars": 84,
      "source_sample_chars": 42,
      "source_text": "项目初期未能对资源需求进行精确评估，导致某些任务资源不足，影响了项目进展的顺利进行。",
      "bounds_pt": [
        278.8,
