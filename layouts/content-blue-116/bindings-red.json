        181.6,
        60.1
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_60",
      "shape_id": 60,
      "shape_name": "文本框 59",
      "type": "text",
      "max_chars": 88,
      "source_sample_chars": 44,
      "source_text": "资源调配不均，某些环节出现资源浪费，而其他环节却因资源短缺而进展缓慢，造成工作效率低下。",
      "bounds_pt": [
        278.8,
        314.9,
        181.6,
        60.1
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_61",
      "shape_id": 61,
      "shape_name": "文本框 60",
      "type": "text",
      "max_chars": 82,
      "source_sample_chars": 41,
      "source_text": "团队内部缺乏统一的沟通流程，信息传递不及时，导致协作困难，容易导致误解和执行偏差。",
      "bounds_pt": [
        499.6,
        193.7,
        181.6,
        60.1
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_62",
      "shape_id": 62,
      "shape_name": "文本框 61",
      "type": "text",
      "max_chars": 94,
      "source_sample_chars": 47,
      "source_text": "过多的沟通渠道导致信息分散且易丢失，工作人员在不同平台之间反复核对，增加了工作负担和错误风险。",
      "bounds_pt": [
        499.6,
        314.9,
        181.6,
        60.1
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_63",
      "shape_id": 63,
      "shape_name": "文本框 62",
      "type": "text",
      "max_chars": 80,
      "source_sample_chars": 40,
      "source_text": "项目中缺少有效的质量控制点，导致项目结束后需要进行大规模返工，增加了成本和时间。",
      "bounds_pt": [
        720.4,
        193.7,
        181.6,
        60.1
      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_64",
