      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_42",
      "shape_id": 42,
      "shape_name": "文本框 41",
      "type": "text",
      "max_chars": 90,
      "source_sample_chars": 45,
      "source_text": "我积极投入到新技术的学习中，特别是在动画和设计领域，通过课程和项目不断提升自己的专业能力。",
