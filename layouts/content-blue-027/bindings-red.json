      ],
      "semantic_role": "provisional"
    },
    {
      "field": "text_43",
      "shape_id": 43,
      "shape_name": "文本框 42",
      "type": "text",
      "max_chars": 82,
      "source_sample_chars": 41,
      "source_text": "通过合理的时间规划，我能更加高效地完成学业和工作任务，还能够按时高质量地完成目标。",
      "bounds_pt": [
        281.5,
