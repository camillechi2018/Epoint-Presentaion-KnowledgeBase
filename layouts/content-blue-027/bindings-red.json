    {
      "field": "text_9",
      "shape_id": 9,
      "shape_name": "文本框 8",
      "type": "text",
      "max_chars": 90,
      "source_sample_chars": 45,
      "source_text": "我在工作中积累了宝贵的经验，这不仅帮助我提升了工作技能，也使我对行业发展有了更深入的理解。",
      "bounds_pt": [
