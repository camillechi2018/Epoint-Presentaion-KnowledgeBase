    },
    {
      "field": "text_39",
      "shape_id": 39,
      "shape_name": "文本框 38",
      "type": "text",
      "max_chars": 86,
      "source_sample_chars": 43,
      "source_text": "与人合作是每个职场人都必须面对的挑战，而我通过与同事的互动，提升了自己的团队合作能力。",
      "bounds_pt": [
