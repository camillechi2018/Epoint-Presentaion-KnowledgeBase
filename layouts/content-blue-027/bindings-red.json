      "shape_name": "文本框 43",
      "type": "text",
      "max_chars": 82,
      "source_sample_chars": 41,
      "source_text": "通过参与多个项目的执行，我逐渐掌握了项目策划实施的流程，提升了自己的团队协作能力。",
      "bounds_pt": [
