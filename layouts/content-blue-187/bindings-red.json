    },
    {
      "field": "text_43",
      "shape_id": 43,
      "shape_name": "文本框 42",
      "type": "text",
      "max_chars": 166,
      "source_sample_chars": 83,
      "source_text": "市场深度开发与渠道建设：重点突破新区域市场并建立完善的渠道网络体系，提升业务范围。\n产品创新与服务体系升级：持续推进新产品研发并优化客户服务体验流程，提高客户留存率。",
      "bounds_pt": [
        308.1,
        231.0,
        299.6,
